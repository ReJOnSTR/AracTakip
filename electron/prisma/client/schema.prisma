generator client {
  provider = "prisma-client-js"
  output   = "../electron/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model assignments {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int?
  item_name   String
  quantity    Int?      @default(1)
  assigned_to String?
  department  String?
  start_date  DateTime
  end_date    DateTime?
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  vehicles    vehicles? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_assignments_vehicle")
}

model companies {
  id                     Int                      @id @default(autoincrement())
  user_id                Int
  name                   String
  tax_number             String?
  address                String?
  phone                  String?
  created_at             DateTime?                @default(now())
  users                  users                    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees              employees[]
  meal_settings          meal_settings?
  meal_tickets           meal_tickets[]
  recurring_transactions recurring_transactions[]
  transactions           transactions[]
  vehicles               vehicles[]
  works                  works[]
  customers              customers[]

  @@index([user_id], map: "idx_companies_user")
}

model customers {
  id          Int       @id @default(autoincrement())
  company_id  Int
  name        String
  phone       String?
  email       String?
  address     String?
  tax_number  String?
  tax_office  String?
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  companies   companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works       works[]

  @@index([company_id], map: "idx_customers_company")
}

model documents {
  id           Int       @id @default(autoincrement())
  vehicle_id   Int?
  related_type String?
  related_id   Int?
  file_name    String
  file_path    String
  file_type    String?
  doc_type     String?
  start_date   DateTime?
  end_date     DateTime?
  created_at   DateTime? @default(now())
  vehicles     vehicles? @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model employee_assignments {
  id            Int       @id @default(autoincrement())
  employee_id   Int
  item_name     String
  quantity      Int?      @default(1)
  assigned_date DateTime?
  return_date   DateTime?
  status        String?   @default("active")
  notes         String?
  created_at    DateTime? @default(now())
  employees     employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_assignments_employee")
}

model employee_attendance {
  id          Int       @id @default(autoincrement())
  employee_id Int
  date        DateTime
  status      String
  description String?
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([employee_id, date], map: "sqlite_autoindex_employee_attendance_1")
}

model employee_documents {
  id          Int       @id @default(autoincrement())
  employee_id Int
  file_name   String
  file_path   String
  file_type   String?
  category    String?
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_documents_employee")
}

model employee_movements {
  id             Int       @id @default(autoincrement())
  employee_id    Int
  type           String
  amount         Float?    @default(0)
  date           DateTime
  description    String?
  is_paid        Int?      @default(0)
  created_at     DateTime? @default(now())
  payment_method String?   @default("cash")
  employees      employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model employee_salary_history {
  id          Int       @id @default(autoincrement())
  employee_id Int
  amount      Float?    @default(0)
  start_date  DateTime
  end_date    DateTime?
  type        String?   @default("initial")
  description String?
  created_at  DateTime? @default(now())
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_employee_salary_history_employee")
}

model employees {
  id                      Int                       @id @default(autoincrement())
  company_id              Int
  first_name              String
  last_name               String
  tc_no                   String?
  phone                   String?
  email                   String?
  position                String?
  department              String?
  start_date              DateTime?
  end_date                DateTime?
  salary                  Float?                    @default(0)
  status                  String?                   @default("active")
  notes                   String?
  image                   String?
  created_at              DateTime?                 @default(now())
  past_used_leaves        Int?                      @default(0)
  birth_date              DateTime?
  employee_assignments    employee_assignments[]
  employee_attendance     employee_attendance[]
  employee_documents      employee_documents[]
  employee_movements      employee_movements[]
  employee_salary_history employee_salary_history[]
  companies               companies                 @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leaves                  leaves[]
  overtimes               overtimes[]
  salaries                salaries[]
  work_items              work_items[]
  works                   works[]

  @@index([company_id], map: "idx_employees_company")
}

model inspections {
  id              Int       @id @default(autoincrement())
  vehicle_id      Int
  inspection_date DateTime
  next_inspection DateTime?
  result          String?
  cost            Float?    @default(0)
  notes           String?
  created_at      DateTime? @default(now())
  type            String?   @default("traffic")
  file_path       String?
  is_archived     Int?      @default(0)
  vehicles        vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_inspections_vehicle")
}

model insurances {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int
  company     String
  policy_no   String?
  type        String
  start_date  DateTime
  end_date    DateTime
  premium     Float?    @default(0)
  notes       String?
  created_at  DateTime? @default(now())
  file_path   String?
  is_archived Int?      @default(0)
  vehicles    vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_insurances_vehicle")
}

model leaves {
  id          Int       @id @default(autoincrement())
  employee_id Int
  type        String    @default("annual")
  start_date  DateTime
  end_date    DateTime
  days        Int?      @default(1)
  status      String?   @default("approved")
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_leaves_employee")
}

model maintenances {
  id          Int       @id @default(autoincrement())
  vehicle_id  Int
  type        String
  description String?
  date        DateTime
  cost        Float?    @default(0)
  next_km     Int?
  next_date   DateTime?
  notes       String?
  created_at  DateTime? @default(now())
  file_path   String?
  is_archived Int?      @default(0)
  vehicles    vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_maintenances_vehicle")
}

model meal_settings {
  id               Int       @id @default(autoincrement())
  company_id       Int       @unique(map: "sqlite_autoindex_meal_settings_1")
  price_per_person Float     @default(0)
  created_at       DateTime? @default(now())
  is_archived      Int?      @default(0)
  companies        companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model meal_tickets {
  id           Int       @id @default(autoincrement())
  company_id   Int
  date         DateTime
  person_count Int       @default(1)
  notes        String?
  created_at   DateTime? @default(now())
  is_archived  Int?      @default(0)
  companies    companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model overtimes {
  id          Int       @id @default(autoincrement())
  employee_id Int
  date        DateTime
  hours       Float?    @default(0)
  rate        Float?    @default(1.5)
  amount      Float?    @default(0)
  notes       String?
  created_at  DateTime? @default(now())
  is_archived Int?      @default(0)
  employees   employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_overtimes_employee")
}

model recurring_transactions {
  id            Int       @id @default(autoincrement())
  company_id    Int
  type          String
  method        String?   @default("CASH")
  amount        Float
  category      String?   @default("Diğer")
  description   String?
  frequency     String?   @default("MONTHLY")
  next_run_date DateTime
  is_active     Int?      @default(1)
  created_at    DateTime? @default(now())
  is_archived   Int?      @default(0)
  companies     companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model salaries {
  id           Int       @id @default(autoincrement())
  employee_id  Int
  period       String
  base_salary  Float?    @default(0)
  bonus        Float?    @default(0)
  deduction    Float?    @default(0)
  net_salary   Float?    @default(0)
  payment_date DateTime?
  status       String?   @default("pending")
  notes        String?
  created_at   DateTime? @default(now())
  is_archived  Int?      @default(0)
  employees    employees @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employee_id], map: "idx_salaries_employee")
}

model schema_migrations {
  version    Int       @id @default(autoincrement())
  applied_at DateTime? @default(now())
}

model services {
  id           Int       @id @default(autoincrement())
  vehicle_id   Int
  type         String
  service_name String?
  description  String?
  date         DateTime
  km           Int?
  cost         Float?    @default(0)
  notes        String?
  created_at   DateTime? @default(now())
  file_path    String?
  is_archived  Int?      @default(0)
  vehicles     vehicles  @relation(fields: [vehicle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicle_id], map: "idx_services_vehicle")
}

model transactions {
  id             Int       @id @default(autoincrement())
  company_id     Int
  date           DateTime
  type           String
  category       String?
  amount         Float?    @default(0)
  description    String?
  payment_method String?
  created_at     DateTime? @default(now())
  method         String?   @default("CASH")
  check_number   String?
  check_due_date DateTime?
  status         String?   @default("COMPLETED")
  currency       String?   @default("TRY")
  is_archived    Int?      @default(0)
  companies      companies @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_transactions_date")
  @@index([company_id], map: "idx_transactions_company")
}

model users {
  id                   Int         @id @default(autoincrement())
  username             String      @unique(map: "sqlite_autoindex_users_1")
  email                String      @unique(map: "sqlite_autoindex_users_2")
  password_hash        String
  created_at           DateTime?   @default(now())
  must_change_password Int?        @default(0)
  companies            companies[]
}

model vehicles {
  id           Int            @id @default(autoincrement())
  company_id   Int
  type         String
  plate        String
  brand        String?
  model        String?
  year         Int?
  color        String?
  status       String?        @default("active")
  km           Int?           @default(0)
  image        String?
  notes        String?
  created_at   DateTime?      @default(now())
  is_archived  Int?           @default(0)
  assignments  assignments[]
  documents    documents[]
  inspections  inspections[]
  insurances   insurances[]
  maintenances maintenances[]
  services     services[]
  companies    companies      @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  work_items   work_items[]
  works        works[]

  @@index([company_id], map: "idx_vehicles_company")
}

model work_items {
  id             Int        @id @default(autoincrement())
  work_id        Int
  date           DateTime
  receipt_no     String?
  vehicle_id     Int?
  employee_id    Int?
  start_time     String?
  end_time       String?
  hours          Float?     @default(0)
  overtime_hours Float?     @default(0)
  unit_price     Float?     @default(0)
  travel_price   Float?     @default(0)
  total_price    Float?     @default(0)
  description    String?
  created_at     DateTime?  @default(now())
  is_archived    Int?       @default(0)
  employees      employees? @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  vehicles       vehicles?  @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction)
  works          works      @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_work_items_date")
  @@index([work_id], map: "idx_work_items_work")
}

model works {
  id          Int          @id @default(autoincrement())
  company_id  Int
  vehicle_id  Int?
  employee_id Int?
  customer_id Int?
  customer    String?
  title       String
  description String?
  status      String?      @default("pending")
  price       Float?       @default(0)
  location    String?
  created_at  DateTime?    @default(now())
  start_date  DateTime?
  end_date    DateTime?
  is_archived Int?         @default(0)
  work_items  work_items[]
  employees   employees?   @relation(fields: [employee_id], references: [id], onUpdate: NoAction)
  vehicles    vehicles?    @relation(fields: [vehicle_id], references: [id], onUpdate: NoAction)
  companies   companies    @relation(fields: [company_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customers   customers?   @relation(fields: [customer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([company_id], map: "idx_works_company")
  @@index([customer_id], map: "idx_works_customer")
}
