{
  "name": "kontrol-app",
  "version": "1.10.0",
  "description": "Kontrol - Filo Yönetim Sistemi",
  "author": "Halil Sak",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/clear-port.js && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "npx prisma generate && vite build && electron-builder",
    "publish": "npx prisma generate && vite build && electron-builder --publish always",
    "preview": "vite preview",
    "rebuild": "npx electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-better-sqlite3": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@tanstack/react-query": "^5.90.16",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.6",
    "electron-log": "^5.4.3",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.294.0",
    "pdfjs-dist": "^5.4.530",
    "pg": "^8.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.69.0",
    "react-is": "^19.2.7",
    "react-pdf": "^10.3.0",
    "react-router-dom": "^6.20.0",
    "react-to-print": "^3.2.0",
    "react-virtuoso": "^4.18.1",
    "recharts": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "dotenv": "^17.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "prisma": "^7.4.2",
    "vite": "^5.4.15",
    "vitest": "^4.0.18",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kontrol.app",
    "productName": "Kontrol",
    "directories": {
      "output": "dist-electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ReJOnSTR",
        "repo": "kontrol-app",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**/*",
      "dist/**/*",
      "data/**/*",
      "prisma/**/*",
      "scripts/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon-win.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
