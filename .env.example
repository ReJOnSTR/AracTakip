# ==========================================
# KONTROL - Production Environment Variables
# (Configure these in Dokploy Environment Settings)
# ==========================================

# Application Port
PORT=3000
NODE_ENV=production

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_POSTGRES_HOST:5432/postgres

# JWT Secret for Session & API Token Security
JWT_SECRET=YOUR_VERY_STRONG_JWT_SECRET_KEY_MIN_32_CHARS

# Supabase URL & Keys (for Auth & Storage)
SUPABASE_URL=https://supabase.kontrol-app.com
SUPABASE_ANON_KEY=sb_publishable_36cfd54f23bbf88d313317_24673797
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Frontend Vite Variables (Injected during build)
VITE_SUPABASE_URL=https://supabase.kontrol-app.com
VITE_SUPABASE_ANON_KEY=sb_publishable_36cfd54f23bbf88d313317_24673797

# Storage & Data Paths
DATA_DIR=/app/data
BACKUP_DIR=/app/backups
