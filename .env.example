# Kontrol App - Environment Configuration Example

# Server Port
PORT=3000

# Database Connection (Supabase PostgreSQL / Self-hosted PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@45.147.47.56:5432/postgres"

# Supabase Configuration
SUPABASE_URL="https://supabase.kontrol-app.com"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_36cfd54f23bbf88d313317_24673797"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# Frontend Vite Variables (exposes to browser bundle)
VITE_SUPABASE_URL="https://supabase.kontrol-app.com"
VITE_SUPABASE_ANON_KEY="sb_publishable_36cfd54f23bbf88d313317_24673797"

# JWT Secret Key
JWT_SECRET="kontrol-app-production-secret-key-98765"
